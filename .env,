# Slack app credentials (Socket Mode: no public webhook needed for events)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# The Keycard zone this agent lives in
KEYCARD_ZONE_URL=https://z-abc123.keycard.cloud
KEYCARD_ZONE_ID=zone_123
KEYCARD_API_BASE_URL=https://api.keycard.ai

# The agent's own identity. Used to authenticate the agent to Keycard before it
# exchanges a user's token, and to authenticate the agent acting as itself.
KEYCARD_CLIENT_ID=slack-agent
KEYCARD_CLIENT_SECRET=...

# The agent's own resource. Every per-request exchange needs a legal audience to
# start from, so the application is paired with a small resource it provides.
KEYCARD_RESOURCE=urn:example:slack-agent

# Service-account credentials, used only to read the zone inventory (which MCP
# servers exist). Never used to reach a user's data.
KEYCARD_SERVICE_ACCOUNT_ID=...
KEYCARD_SERVICE_ACCOUNT_SECRET=...

# Public base URL, used to build the OAuth redirect and consent links
BASE_URL=https://your-agent.example.com
PORT=8080

DATABASE_PATH=/data/slack-agent.db

# 32 bytes. Encrypts the stored user tokens at rest.
ENCRYPTION_KEY=change-me-32-bytes-exactly!!!!!!
# Signs the OAuth state parameter.
STATE_SECRET=change-me

ANTHROPIC_API_KEY=...

# Optional. Overrides the model the agent runs on.
ANTHROPIC_MODEL=claude-opus-5
